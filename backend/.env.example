# ============================================================
# APPLICATION
# ============================================================

APP_NAME=Policy DB Chatbot
APP_ENV=development
DEBUG=true

# Uvicorn bind address
HOST=127.0.0.1
PORT=8000

# JWT — must be at least 32 characters
SECRET_KEY=replace-me-with-a-random-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# DATABASE
# ============================================================

# SQLite (default for dev). Postgres is used via docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# Postgres credentials (only used by docker-compose)
POSTGRES_USER=policy
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=policy_db

# ============================================================
# LLM PROVIDER CHAIN
# ============================================================
# Primary provider, plus two optional fallbacks. The pipeline tries
# each in order if the previous one fails.

LLM_PROVIDER=deepseek
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_PROVIDER_2=claude

# ─── DeepSeek (primary) ─────────────────────────────────────
DEEPSEEK_API_KEY=sk-replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ─── Gemini (fallback 1) ────────────────────────────────────
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# ─── Claude (fallback 2) ────────────────────────────────────
# Optional: leave blank to disable the Claude fallback.
CLAUDE_API_KEY=replace-with-your-claude-key
CLAUDE_MODEL=claude-haiku-4-5

# ============================================================
# HUGGING FACE (embeddings)
# ============================================================

HF_TOKEN=replace-with-your-huggingface-token
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Optional: path to a pre-downloaded local model. Only used by the
# optional LocalEmbeddingService (kept in backend/_pending/).
# EMBEDDING_LOCAL_PATH=/path/to/local/bge-m3

# ============================================================
# QDRANT (vector store)
# ============================================================

# "local" uses embedded Qdrant at QDRANT_PATH.
# "remote" connects to QDRANT_URL (used inside Docker).
QDRANT_MODE=local
QDRANT_PATH=./storage/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks

# ============================================================
# RETRIEVAL
# ============================================================

VECTOR_TOP_K=20
LEXICAL_TOP_K=20
RRF_K=60
FINAL_CONTEXT_CHUNKS=12

# Adaptive window & broadening
RETRIEVAL_LOW_CONFIDENCE_THRESHOLD=0.12
QUERY_BROADENING_ENABLED=true

# Chunk compression (head + tail)
CHUNK_LONG_THRESHOLD=400
CHUNK_LONG_TAIL=100

# Dynamic context window based on retrieval confidence
CONTEXT_BY_CONFIDENCE=true

# Conversation history budget (approximate tokens)
CONVERSATION_TOKEN_BUDGET=600

# Per-policy cap in the final context
MAX_CHUNKS_PER_POLICY=2

# Scoring floors
MIN_RETRIEVAL_SCORE=0.15
MIN_GENERATION_SUPPORT=0.60

# Query rewriting (follow-up resolution)
QUERY_REWRITING_ENABLED=true

# ============================================================
# SECURITY
# ============================================================

MAX_QUERY_LENGTH=2000
MAX_CONVERSATION_TURNS=8
RATE_LIMIT_PER_MINUTE=10

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Verbose RAG pipeline logging (dev only — produces a lot of output)
DEBUG_PIPELINE=false

# ============================================================
# POLICY DATA
# ============================================================

POLICY_JSONL_PATH=data/raw/policies.jsonl